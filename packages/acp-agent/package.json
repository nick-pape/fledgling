{
  "name": "@fledgling/acp-agent",
  "version": "0.0.0",
  "private": true,
  "description": "A minimal ACP stdio agent backed by Vercel AI SDK.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "fledgling-acp-agent": "lib/index.js"
  },
  "scripts": {
    "build": "heft build --clean",
    "_phase:build": "heft run --only build -- --clean",
    "test": "vitest run",
    "_phase:test": "vitest run --coverage",
    "smoke": "node tools/smoke-client.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.4.3",
    "@ai-sdk/mcp": "0.0.18",
    "@ai-sdk/openai": "^2.0.0",
    "@fledgling/common": "workspace:*",
    "@fledgling/context-builder": "workspace:*",
    "@fledgling/mcp-workspace": "workspace:*",
    "@fledgling/session-log": "workspace:*",
    "ai": "^5.0.0"
  },
  "devDependencies": {
    "@fledgling/heft-rig": "workspace:*",
    "@rushstack/heft": "1.2.7",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "vitest": "^3.1.1",
    "typescript": "~5.9.0"
  }
}
