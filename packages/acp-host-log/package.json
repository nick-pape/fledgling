{
  "name": "@fledgling/acp-host-log",
  "version": "0.0.0",
  "private": true,
  "description": "A small logging ACP host for exercising Fledgling sessions.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "fledgling-acp-host-log": "lib/index.js"
  },
  "scripts": {
    "build": "heft build --clean",
    "start": "node lib/index.js",
    "snapshot": "node lib/index.js --json --deterministic"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.4.3",
    "@fledgling/acp-agent": "workspace:*",
    "@fledgling/mcp-workspace": "workspace:*",
    "dotenv": "^17.0.0",
    "pino": "~10.3.1",
    "pino-pretty": "~13.1.3"
  },
  "devDependencies": {
    "@fledgling/heft-rig": "workspace:*",
    "@rushstack/heft": "~0.75.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0"
  }
}
