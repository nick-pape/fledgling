  },
  "devDependencies": {
    "@fledgling/heft-rig": "workspace:*",
    "@rushstack/heft": "1.2.7",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.1.1",
    "typescript": "~5.9.0",
    "vitest": "^3.1.1",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  }
